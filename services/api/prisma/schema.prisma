datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TaskStatus {
  INBOX
  APPROVED
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

enum ReminderPreference {
  CALL_ME
  NOTIFICATION_ONLY
  OFF
}

enum SourceType {
  MANUAL
  GOOGLE_CLASSROOM
  GMAIL
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String   @default("Aditya Madala")
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks          Task[]
  reminders      Reminder[]
  routineBlocks  RoutineBlock[]
  mealLogs       MealLog[]
  waterLogs      WaterLog[]
  stepLogs       StepLog[]
  workoutLogs    WorkoutLog[]
  syncTokens     SyncToken[]

  @@map("users")
}

model Task {
  id                      String             @id @default(uuid())
  userId                  String
  title                   String
  description             String?
  status                  TaskStatus         @default(INBOX)
  officialDeadline        DateTime?
  deadlineStatus          String             @default("confirmed") // confirmed, time_unspecified, deadline_unconfirmed
  finishByDate            DateTime?
  studySlotStart          DateTime?
  studySlotDurationMinutes Int?
  reminderPreference      ReminderPreference @default(CALL_ME)
  
  sourceType              SourceType         @default(MANUAL)
  sourceId                String?            // External Classroom or Gmail ID for deduplication
  sourceEvidence          String?
  sourceUrl               String?

  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders               Reminder[]

  @@unique([userId, sourceId, sourceType])
  @@index([userId, status])
  @@map("tasks")
}

model Reminder {
  id               String             @id @default(uuid())
  userId           String
  taskId           String?
  title            String
  spokenMessage    String
  scheduledAt      DateTime
  preference       ReminderPreference @default(CALL_ME)
  isWaterReminder  Boolean            @default(false)
  status           String             @default("pending") // pending, snoozed, answered, dismissed, completed

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  task             Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, scheduledAt])
  @@map("reminders")
}

model RoutineBlock {
  id          String   @id @default(uuid())
  userId      String
  name        String
  startTime   String   // "06:15", "15:00"
  endTime     String   // "07:00", "17:00"
  daysOfWeek  Int[]    // [1, 2, 3, 4, 5]
  subBlocks   Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("routine_blocks")
}

model MealLog {
  id                String   @id @default(uuid())
  userId            String
  mealType          String   // breakfast, lunch, pre_gym, dinner, snack
  itemsDescription  String
  photoPath         String?
  estimatedCalories Int?
  estimatedCostInr  Float?
  loggedAt          DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("meal_logs")
}

model WaterLog {
  id        String   @id @default(uuid())
  userId    String
  amountMl  Int
  loggedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("water_logs")
}

model StepLog {
  id           String   @id @default(uuid())
  userId       String
  stepCount    Int
  source       String   @default("google_fit_manual") // screenshot, typed_manual
  date         DateTime @db.Date
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("step_logs")
}

model WorkoutLog {
  id           String   @id @default(uuid())
  userId       String
  title        String   // "Gym: Chest & Triceps"
  exercises    Json     // Array of { name, sets: [{ reps, weight }] }
  loggedAt     DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workout_logs")
}

model SyncToken {
  id           String   @id @default(uuid())
  userId       String
  provider     String   // google_classroom, gmail
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  lastSyncAt   DateTime?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("sync_tokens")
}
